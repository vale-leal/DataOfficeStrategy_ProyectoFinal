<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="HidroData SIN · ArchiMate v1.0" id="id-1c8ec114d6f5570aa61df93213d65c99" version="5.0.0">
  <folder name="Strategy" id="id-dbd56f12bbbd5a359c1d00130b09978f" type="strategy">
  </folder>
  <folder name="Business" id="id-0d8ec41f13b95cbd9daee383b483bb56" type="business">
    <element xsi:type="archimate:BusinessActor" name="Planeación Energética" id="id-8f5bf39c7fa152868415d8f091cfd4dc"><documentation>Área de negocio dueña del significado del dato y de los umbrales (spoke del Data Office federado).</documentation></element>
    <element xsi:type="archimate:BusinessActor" name="Data Office (CDO)" id="id-508cee4c3ebc53f2b6c11574d9bbdcc7"><documentation>Unidad staff de la Gerencia General; define políticas, estándares, calidad y arquitectura (hub).</documentation></element>
    <element xsi:type="archimate:BusinessActor" name="Comité de Riesgo Hídrico" id="id-cdda4630d01c5349bebacc12049aeda1"><documentation>Presidido por el Gerente de Energía; decide acciones ante una alerta y registra la decisión.</documentation></element>
    <element xsi:type="archimate:BusinessRole" name="Data Owner" id="id-7b89e06c552a54e9b8b19424b9b15c12"><documentation>Jefatura de Planeación Energética. Aprueba definiciones, reglas, clasificación y umbrales (RACI: A).</documentation></element>
    <element xsi:type="archimate:BusinessRole" name="Analista de datos" id="id-79954dc580945bdf8028d3d608194eb9"><documentation>Consumidor del dato: construye indicadores y publica el dashboard.</documentation></element>
    <element xsi:type="archimate:BusinessRole" name="Data Steward" id="id-333ccf0506a8597da59469f0628c0782"><documentation>Significado y calidad diaria del dato: catálogo, diccionario, reglas e incidentes.</documentation></element>
    <element xsi:type="archimate:BusinessRole" name="Custodio técnico" id="id-0bb23f5b5440588bad7bd079951f8046"><documentation>Implementa y opera el pipeline, el almacenamiento, el linaje y los accesos.</documentation></element>
    <element xsi:type="archimate:BusinessProcess" name="Monitoreo y alerta de reservas hídricas" id="id-153a0c9314b0526b8691dd7fad9e0fc9"><documentation>Proceso TO-BE del BPMN (mejoras M1 a M6).</documentation></element>
    <element xsi:type="archimate:BusinessProcess" name="Obtener y validar datos (M1–M3)" id="id-798d93f62ed456ec942699d835cd869a"><documentation>Descarga de Sinergox, validación de reglas de calidad y revisión de incidentes por el Data Steward.</documentation></element>
    <element xsi:type="archimate:BusinessProcess" name="Calcular indicadores y publicar dashboard (M4)" id="id-f43b8113aa0359689432e221a56ecb79"><documentation>Indicadores diarios y mensuales, linaje y publicación del dashboard.</documentation></element>
    <element xsi:type="archimate:BusinessProcess" name="Enviar alerta por umbral (M5)" id="id-e37efd7ab2fb506d9690801d36b60dad"><documentation>Si el volumen útil cruza el umbral aprobado, se envía la alerta por correo.</documentation></element>
    <element xsi:type="archimate:BusinessProcess" name="Decidir y registrar la decisión (M6)" id="id-a8ccc9ececab52a3a06958e201236ac5"><documentation>El comité analiza la alerta en el dashboard, decide y deja constancia.</documentation></element>
    <element xsi:type="archimate:BusinessService" name="Información hídrica diaria validada" id="id-70406ec93bc154bcbb970d1c5e3851cd"><documentation>Estado de reservas, aportes y generación con calidad medida.</documentation></element>
    <element xsi:type="archimate:BusinessService" name="Alerta de riesgo hídrico" id="id-aa99a92ec3295698933ee559e899c532"><documentation>Aviso oportuno cuando se superan los umbrales aprobados.</documentation></element>
    <element xsi:type="archimate:BusinessObject" name="Plan de Gobierno de Datos" id="id-66d643c381015010b93345be9313476c"><documentation>Políticas, RACI, catálogo, reglas de calidad, linaje, clasificación y acceso.</documentation></element>
    <element xsi:type="archimate:BusinessObject" name="Umbrales de riesgo aprobados" id="id-e6d992332d585273b825521c512c4bc9"><documentation>Vigilancia 50 % y crítico 40 % del volumen útil (propuestos por el EDA, aprueba el Data Owner).</documentation></element>
    <element xsi:type="archimate:BusinessObject" name="Registro de decisiones" id="id-a860a60b1ee9515993b54404df743d05"><documentation>Constancia de cada decisión del comité con los datos que la motivaron (O4).</documentation></element>
  </folder>
  <folder name="Application" id="id-5f3ecb2ea23b52d8902071ee3fc83f00" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Pipeline HidroData (run_pipeline.py)" id="id-279d59e31e795e9b957d13f9ce354d46"><documentation>Orquesta ingesta, normalización y limpieza, y calidad.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Ingesta (src/ingesta.py)" id="id-2f8274f2a6f655a7b583bc26b4a140f0"><documentation>Une los .xlsx anuales por colección y guarda un parquet por colección.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Normalización y limpieza (normalizacion.py, limpieza.py)" id="id-093d165a6da751e1b431319cdf309aac"><documentation>Tipos, nombres, validez e imputaciones con bitácora.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Calidad (src/calidad.py)" id="id-67a52245c58b56ad8f5f62587567e141"><documentation>Métricas de completitud, unicidad, validez y cobertura por colección.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Notebook EDA (04_eda.ipynb)" id="id-989000889b0b590896b5d5870d43be03"><documentation>Análisis exploratorio; produce los indicadores mensuales y la tabla de alerta.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Dashboard HidroData" id="id-4a7ba692f94754308890a30a496fd594"><documentation>Visualización para la toma de decisiones del comité.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Flujo de alerta (Power Automate)" id="id-b9a6e5a67564597e937c3d2ed52e2208"><documentation>Lee el estado más reciente de TablaReservas y envía el correo de alerta.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Medición de reglas de gobierno (scripts + Excel S2)" id="id-caf3fba6c301525b8a5fd2c9da4f3b13"><documentation>construir_gobierno.py, calidad_tablas_grandes.py y los 7 Excel de gobierno.</documentation></element>
    <element xsi:type="archimate:ApplicationService" name="Reporte de calidad del dato" id="id-64592d4a4244581c95e7502daec25c09"><documentation>Resultado de las reglas por dataset con semáforo.</documentation></element>
    <element xsi:type="archimate:ApplicationService" name="Datos normalizados y validados" id="id-2ce67913dbde59fea6e7cf7cd6465409"><documentation>Siete colecciones de XM limpias y con tipos estándar.</documentation></element>
    <element xsi:type="archimate:ApplicationService" name="Visualización de indicadores" id="id-c54629d2b9335f08b0797454313b8511"><documentation>Consulta del estado hídrico y de la calidad en el dashboard.</documentation></element>
    <element xsi:type="archimate:ApplicationService" name="Notificación de alerta" id="id-8816d96daf305514912f5691f2d53cf3"><documentation>Envío automático del correo de alerta al comité.</documentation></element>
    <element xsi:type="archimate:DataObject" name="Datos crudos XM (7 colecciones .xlsx)" id="id-d1f55e871cde54aa9015f518350ef4f3"><documentation>DS-01 a DS-07, 2022–2026, tal como se descargan de Sinergox.</documentation></element>
    <element xsi:type="archimate:DataObject" name="Datos normalizados (.parquet)" id="id-16c5c6b09bb059eeb07f6409d387a929"><documentation>data/processed/normalizado: una tabla por colección.</documentation></element>
    <element xsi:type="archimate:DataObject" name="Bitácoras y métricas de calidad" id="id-1e55c18e35c35da3bfcac51100b41dec"><documentation>data/processed/calidad: métricas, incidentes e imputaciones.</documentation></element>
    <element xsi:type="archimate:DataObject" name="Indicadores mensuales (eda_mensual)" id="id-fd4eabd419945c519b3d50d208869552"><documentation>data/processed/eda/eda_mensual.parquet: insumo del dashboard.</documentation></element>
    <element xsi:type="archimate:DataObject" name="Tabla de alerta (TablaReservas)" id="id-d8f26b05f66e576d94cbcffa3b3c5bf8"><documentation>Fecha, volumen útil, variación 30 días, umbrales y estado.</documentation></element>
    <element xsi:type="archimate:DataObject" name="Catálogo, diccionario y scorecard de calidad" id="id-b9c7ac55b44a5ba1be5c3ef0d13decca"><documentation>Excel S2 de gobierno por dataset (DS-01 a DS-07).</documentation></element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-7606b671f87c515cb3f05196ed71cd2a" type="technology">
    <element xsi:type="archimate:Node" name="XM Sinergox (externo)" id="id-5ffd40b9ac0352aab3c12e2ef412d6da"><documentation>Portal de información del mercado mayorista. La descarga hoy es manual.</documentation></element>
    <element xsi:type="archimate:TechnologyService" name="Exportación de históricos (.xlsx)" id="id-adb312d74b825e588093f1ed010ba1f2"><documentation>Descarga anual por colección desde sinergox.xm.com.co.</documentation></element>
    <element xsi:type="archimate:Node" name="Estación de trabajo del equipo" id="id-1a1a19d3d63f5efcafc1b5dac99fc3f2"><documentation>Equipo local donde corre el pipeline y los notebooks.</documentation></element>
    <element xsi:type="archimate:SystemSoftware" name="Python 3.10–3.12 · pandas · pyarrow" id="id-4aae8175603f5e3f9dda4d4c1b0e6051"><documentation>Entorno definido en requirements.txt.</documentation></element>
    <element xsi:type="archimate:SystemSoftware" name="JupyterLab" id="id-28ffa1cff55f518589046759acc9b2d7"><documentation>Ejecución de los notebooks.</documentation></element>
    <element xsi:type="archimate:SystemSoftware" name="Herramienta del dashboard" id="id-04d0621fde035ebbab95164a8df25f66"><documentation>Plataforma donde se construye y publica el dashboard.</documentation></element>
    <element xsi:type="archimate:Artifact" name="data/processed/*.parquet" id="id-7f3040ecd17f521fb886edc0d4a2c023"><documentation>Salidas del pipeline y del EDA (no se versionan).</documentation></element>
    <element xsi:type="archimate:Node" name="GitHub · repositorio + Git LFS" id="id-147617ac4daf585997f03574a269b454"><documentation>vale-leal/DataOfficeStrategy_ProyectoFinal: control de versiones y revisión por PR.</documentation></element>
    <element xsi:type="archimate:Artifact" name="run_pipeline.py · src/ · notebooks/" id="id-cb77f28ed27256c9b1ff5104f6f27bd6"><documentation>Código fuente versionado del pipeline y del análisis.</documentation></element>
    <element xsi:type="archimate:Artifact" name="HidrologiaYGeneracionEnergetica_7065.rar" id="id-3892c3e73ca259c6bc2fdf71059e6f4f"><documentation>35 .xlsx crudos (Git LFS); evidencia de la extracción.</documentation></element>
    <element xsi:type="archimate:Node" name="Microsoft 365 (nube)" id="id-aac1203dec695805bace3d2b1dc6b868"><documentation>Licencia institucional.</documentation></element>
    <element xsi:type="archimate:SystemSoftware" name="Power Automate" id="id-25fd55d192f15495801108c434e41c69"><documentation>Ejecuta el flujo programado de alerta.</documentation></element>
    <element xsi:type="archimate:SystemSoftware" name="Outlook" id="id-d5a8b59f63e85790ad7f7ba953cfb0ae"><documentation>Envío del correo de alerta.</documentation></element>
    <element xsi:type="archimate:Artifact" name="reservas_alerta.xlsx (OneDrive)" id="id-3dd412b174ce5c7ca48f7bbd18e0b094"><documentation>Archivo que genera el EDA y lee el flujo.</documentation></element>
